# PostgreSQL (pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_workspace?schema=public"

# Optional shared cache/rate limit store. The app falls back to memory when unavailable.
REDIS_URL="redis://localhost:6379"

# Cache experiments are intentionally disabled until baseline metrics are collected.
CACHE_EXPERIMENT_PROMPT_REORDER="false"
CACHE_EXPERIMENT_REORDER_STRATEGY="rag-to-last-user"
CACHE_EXPERIMENT_MINIMAX_ACTIVE="false"

# Agent Runtime rollout. Default is explicitly `legacy` in every environment.
# `shadow` compares side-effect-free planning decisions while serving legacy
# behavior; `new` enables Runtime-owned Skill state and deterministic prelude.
AGENT_RUNTIME_MODE="legacy"
# Deprecated compatibility bridge when AGENT_RUNTIME_MODE is absent:
# AGENT_ORCHESTRATOR_ENABLED="0"

# Learning loop rollout. Keep `off` for compatibility, use `preview` for an
# opt-in entry, and use `default` only after durable execution is enabled.
LEARNING_LOOP_ROLLOUT="off"
AGENT_DURABLE_EXECUTION_ENABLED="false"

# Paper compilation consumes PaperCompilation CompileJobs. For a separate
# compiler process, set this Web-process flag to false and run
# `npm run paper:compiler` with PAPER_COMPILE_SERVICE_MODE=true. The service
# should run in a resource-limited container; TeX child processes use the
# Linux sandbox flag below for a no-network namespace.
PAPER_COMPILE_WORKER_ENABLED="true"
PAPER_COMPILE_SERVICE_MODE="false"
# PAPER_TEX_ENGINE="xelatex"
# PAPER_COMPILE_TIMEOUT_MS="120000"
# PAPER_COMPILE_MAX_FILES="500"
# PAPER_COMPILE_MAX_SOURCE_BYTES="41943040"
# PAPER_COMPILE_MAX_ARTIFACT_BYTES="83886080"
# PAPER_COMPILE_MAX_LOG_BYTES="12000"
# The isolated compiler image enables bubblewrap for TeX child processes. Do
# not enable this on macOS/local Web unless bubblewrap is installed.
# PAPER_COMPILE_LINUX_SANDBOX="false"
# PAPER_COMPILE_SANDBOX_COMMAND="bwrap"

# Provider protocol layer. Keep legacy by default; set pi only for the
# isolated @earendil-works/pi-ai Adapter POC (pi-ai remains an alias).
AGENT_PROVIDER_ADAPTER="legacy"

# Qwen3.7-Plus rollout. Its API Key continues to be resolved from the central
# Bailian CredentialProfile; do not put provider credentials in this file.
MODEL_QWEN_ENABLED="false"
BAILIAN_WORKSPACE_ID="your-bailian-workspace-id"

# Auth — generate via: openssl rand -base64 32
AUTH_SECRET="please-change-this"

# Admin console — comma-separated email list allowed to access /admin pages and APIs
ADMIN_EMAILS=""

# Encryption Key for API Key storage — 64 hex chars (32 bytes)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY="please-generate-a-64-char-hex-string"

# Alpha registration codes — generate each secret independently.
REGISTRATION_CODE_PEPPER="generate-with-openssl-rand-base64-48"
REGISTRATION_SYNC_SECRET="same-random-secret-as-course-ai-regadmin"
REGISTRATION_SYNC_PRIVATE_KEY_BASE64="base64-encoded-RSA-private-key-PEM"

# DeepSeek API
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Qiniu Kodo private object storage for uploaded source files.
# Access/Secret keys stay server-side only.
QINIU_ACCESS_KEY="your-qiniu-access-key"
QINIU_SECRET_KEY="your-qiniu-secret-key"
QINIU_BUCKET="course-ai-lab"
QINIU_REGION="z2"
QINIU_UPLOAD_HOST="https://up-z2.qiniup.com"
QINIU_PRIVATE_DOMAIN="cdn.example.com"

# App
AUTH_URL="https://app.example.com"
NEXT_PUBLIC_APP_NAME="LumenLab"

# Tencent Cloud SES (email verification & password reset)
# Template IDs come from the SES console after review; when missing, email
# sending falls back to console dry-run so local development never crashes.
TENCENT_SECRET_ID="your-tencentcloud-secret-id"
TENCENT_SECRET_KEY="your-tencentcloud-secret-key"
SES_ENABLED="1"
SES_REGION="ap-hongkong"
SES_FROM_EMAIL="LumenLab@mail.mkynstudio.top"
SES_FROM_NAME="LumenLab"
SES_TEMPLATE_VERIFY=""
SES_TEMPLATE_RESET=""
# SES template ID for feedback notification emails (create in SES console; empty = dry-run)
SES_TEMPLATE_FEEDBACK=""
# 验证/重设链接地址；默认由 AUTH_URL 推导，可通过下面两个变量覆盖
# SES_VERIFY_URL_BASE="https://app.example.com/api/auth/verify/link"
# SES_RESET_URL_BASE="https://app.example.com/api/auth/password/reset-link"
